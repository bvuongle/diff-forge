{
  "schema": "diff.catalog.v3",
  "components": [
    {
      "type": "LinkEth",
      "version": "1.0.0",
      "implements": ["ILink"],
      "requires": [],
      "config": {}
    },
    {
      "type": "LinkGsm",
      "version": "1.0.0",
      "implements": ["ILink"],
      "requires": [],
      "config": {
        "linkReliability": { "type": "uint8", "min": 0, "max": 100, "default": 95 }
      }
    },
    {
      "type": "LinkSat",
      "version": "1.0.0",
      "implements": ["ILink"],
      "requires": [],
      "config": {
        "latencyMs": { "type": "uint16", "min": 100, "max": 10000, "default": 3500 },
        "bandwidthKbps": { "type": "uint16", "min": 1, "max": 1024, "default": 64 }
      }
    },
    {
      "type": "Sensor",
      "version": "1.0.0",
      "implements": ["IDataSource"],
      "requires": [],
      "config": {
        "sampleRate": { "type": "uint", "min": 1, "max": 10000, "default": 100 }
      }
    },
    {
      "type": "Sensor",
      "version": "2.0.0",
      "implements": ["IDataSource", "IMonitorable"],
      "requires": [],
      "config": {
        "sampleRate": { "type": "uint16", "min": 1, "max": 10000, "default": 100 },
        "calibrationOffset": { "type": "int16", "min": -1000, "max": 1000, "default": 0 },
        "isCalibrated": { "type": "bool", "default": true }
      }
    },
    {
      "type": "Timer",
      "version": "1.0.0",
      "implements": ["IDataSource"],
      "requires": [],
      "config": {
        "intervalMs": { "type": "uint", "min": 1, "max": 60000, "default": 1000 }
      }
    },
    {
      "type": "MessageSource",
      "version": "1.0.0",
      "implements": ["IProcessable"],
      "requires": [
        { "name": "link", "type": "ILink" },
        { "name": "backupLink", "type": "ILink" }
      ],
      "config": {
        "count": { "type": "uint32", "min": 1, "max": 1000, "default": 10 },
        "content": { "type": "string", "default": "default message" }
      }
    },
    {
      "type": "DataCollector",
      "version": "1.0.0",
      "implements": ["IProcessable"],
      "requires": [
        { "name": "source", "type": "IDataSource" },
        { "name": "link", "type": "ILink" }
      ],
      "config": {
        "bufferSize": { "type": "uint", "min": 64, "max": 8192, "default": 1024 }
      }
    },
    {
      "type": "Router",
      "version": "1.0.0",
      "implements": ["IRoutable"],
      "requires": [
        { "name": "links", "type": "ILink", "isArray": true }
      ],
      "config": {
        "maxRoutes": { "type": "uint", "min": 1, "max": 256, "default": 64 }
      }
    },
    {
      "type": "Router",
      "version": "2.0.0",
      "implements": ["IRoutable", "IMonitorable"],
      "requires": [
        { "name": "links", "type": "ILink", "isArray": true }
      ],
      "config": {
        "maxRoutes": { "type": "uint", "min": 1, "max": 256, "default": 64 },
        "enableMetrics": { "type": "bool", "default": false },
        "logLevel": { "type": "uint", "min": 0, "max": 3, "default": 1 }
      }
    },
    {
      "type": "Dispatcher",
      "version": "1.0.0",
      "implements": ["IProcessable"],
      "requires": [
        { "name": "processable", "type": "IProcessable" },
        { "name": "routable", "type": "IRoutable" }
      ],
      "config": {
        "maxQueueSize": { "type": "uint", "min": 1, "max": 4096, "default": 256 }
      }
    },
    {
      "type": "Aggregator",
      "version": "1.0.0",
      "implements": ["IProcessable", "IDataSource"],
      "requires": [
        { "name": "inputs", "type": "IDataSource", "isArray": true }
      ],
      "config": {
        "windowMs": { "type": "uint", "min": 10, "max": 60000, "default": 1000 },
        "strategy": { "type": "string", "default": "average" }
      }
    },
    {
      "type": "SystemController",
      "version": "1.0.0",
      "implements": ["IMonitorable"],
      "requires": [
        { "name": "workers", "type": "IProcessable", "isArray": true },
        { "name": "monitors", "type": "IMonitorable", "isArray": true }
      ],
      "config": {
        "heartbeatMs": { "type": "uint", "min": 100, "max": 30000, "default": 5000 },
        "failoverEnabled": { "type": "bool", "default": true }
      }
    }
